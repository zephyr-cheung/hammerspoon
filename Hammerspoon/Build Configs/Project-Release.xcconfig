#include "Project-Base.xcconfig"

// Code Signing Identity
// 同 Hammerspoon-Release.xcconfig：上游用维护者的 Developer ID，custom 分支改用本地
// 自签名证书 `Internal Code Signing`（身份固定 → 重编后辅助功能授权不掉）。
// 没有该证书时在命令行覆盖：CODE_SIGN_IDENTITY=- DEVELOPMENT_TEAM=
CODE_SIGN_IDENTITY = Internal Code Signing
DEVELOPMENT_TEAM =

// Build Active Architecture Only
ONLY_ACTIVE_ARCH = NO

// Enable Testability
ENABLE_TESTABILITY = NO

// Optimization Level
GCC_OPTIMIZATION_LEVEL = s

// Preprocessor Macros
GCC_PREPROCESSOR_DEFINITIONS =
