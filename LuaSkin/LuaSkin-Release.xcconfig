// Configuration settings file format documentation can be found at:
// https://help.apple.com/xcode/#/dev745c5c974

#include "LuaSkin-Base.xcconfig"

// Code Signing Identity
// custom: 上游这里是 `Developer ID Application` + `DEVELOPMENT_TEAM = VQCYSNZB89`（维护者的），
// 本机没有该证书，编 Release 会报 "No signing certificate ... found" 直接失败。
// 改用本地自签名证书 `Internal Code Signing`（身份固定 → 重编后辅助功能授权不掉）；
// 没有该证书时命令行覆盖：CODE_SIGN_IDENTITY=- DEVELOPMENT_TEAM=
CODE_SIGN_IDENTITY = Internal Code Signing
DEVELOPMENT_TEAM =

// Preprocessor Macros
GCC_PREPROCESSOR_DEFINITIONS =

// Build Active Architecture Only
ONLY_ACTIVE_ARCH = NO
// Enable Testability
ENABLE_TESTABILITY = NO

// Optimization Level
GCC_OPTIMIZATION_LEVEL = s

#include? "../../LuaSkin-Downstream.xcconfig"
